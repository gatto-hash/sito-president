---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { SezioneId } from '../data/rotte';

interface Props {
  title: string;
  description?: string;
  /** Sezione attiva nell'header (voce in Bold con linea inferiore). */
  sezione?: SezioneId;
  /** id della linea corrente (pagina di linea o scheda prodotto), evidenziata nel menu LA GAMMA. */
  lineaCorrente?: string;
}
const {
  title,
  description = 'PRESIDENT: igiene orale di derivazione professionale, sviluppata e prodotta in Italia da Betafarma.',
  sezione,
  lineaCorrente,
} = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/img/stemma-nero.svg" type="image/svg+xml" />
    <link rel="preload" href="/assets/fonts/cerapro-light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/cerapro-bold.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <Header sezione={sezione} lineaCorrente={lineaCorrente} />
    <main id="contenuto" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
