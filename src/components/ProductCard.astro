---
/**
 * Card prodotto: link alla scheda /la-gamma/<linea>/<slug>/.
 * Usata nella pagina di linea e nei prodotti correlati della scheda prodotto.
 */
import Icon from './Icon.astro';
import BadgeRda from './badge/BadgeRda.astro';
import BadgeMils from './badge/BadgeMils.astro';
import BadgeFluoro from './badge/BadgeFluoro.astro';
import { hrefProdotto, type Prodotto } from '../data/prodotti';
import type { Linea } from '../data/linee';
import { dim } from '../data/dimensioni-immagini';

interface Props {
  prodotto: Prodotto;
  linea: Linea;
}
const { prodotto: p, linea } = Astro.props;
---
<a
  class="pcard card-hover"
  href={hrefProdotto(p)}
  style={`--pc-name:${linea.testoSuBianco};--pc-light:${linea.tintaChiara};--pc-mid:${linea.tintaMedia}`}
>
  <span class="pcard__media">
    {p.immagine ? (
      <img src={p.immagine} alt="" {...dim(p.immagine)} loading="lazy" class="pcard__img" />
    ) : (
      <span class="pcard__placeholder">
        <img src="/assets/img/stemma-nero.svg" alt="" width="44" height="40" loading="lazy" />
        Foto in arrivo
      </span>
    )}
    {(p.rda !== undefined || p.mils !== undefined) && (
      <span class="pcard__badge">
        {p.rda !== undefined ? <BadgeRda rda={p.rda} size="sm" /> : <BadgeMils mils={p.mils} size="sm" />}
      </span>
    )}
    {p.disponibilita && <span class="pcard__flag">{p.disponibilita.toUpperCase()}</span>}
  </span>
  <span class="pcard__body">
    <span class="pcard__name">{p.nome}</span>
    <span class="pcard__claim">{p.claim}</span>
    {(p.formato || p.varianti) && <span class="pcard__format">{p.formato ?? p.varianti}</span>}
    {p.fluoroPpm !== undefined && <span class="pcard__fluoro"><BadgeFluoro ppm={p.fluoroPpm} /></span>}
    {p.gusti && (
      <span class="pcard__gusti">
        {p.gusti.map((g) => (
          <span class="pcard__gusto">
            <img src={g.immagine} alt="" {...dim(g.immagine)} loading="lazy" />{g.nome}
          </span>
        ))}
      </span>
    )}
    <span class="pcard__more">Scheda prodotto <Icon name="arrow-right" size={16} /></span>
  </span>
</a>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 372px;
    background: #FFFFFF;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    color: var(--c-text);
    text-decoration: none;
  }
  .pcard:hover { color: var(--c-text); }
  .pcard__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    height: 200px;
    background: radial-gradient(120% 90% at 50% 70%, #FFFFFF 0%, var(--pc-light) 55%, var(--pc-mid) 100%);
  }
  .pcard__img {
    width: auto;
    height: auto;
    max-height: 164px;
    max-width: 78%;
    object-fit: contain;
    filter: drop-shadow(0 10px 14px rgba(29, 29, 27, .16));
  }
  .pcard__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--c-muted);
  }
  .pcard__placeholder img { width: 44px; height: auto; opacity: .35; }
  .pcard__badge { position: absolute; right: 14px; top: 14px; }
  .pcard__flag {
    position: absolute;
    left: 12px;
    top: 12px;
    padding: 5px 9px;
    border-radius: var(--radius-pill);
    background: var(--c-strong);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: var(--fw-bold);
    letter-spacing: .06em;
  }
  .pcard__body { display: flex; flex-direction: column; gap: 4px; flex: 1; padding: 16px 18px 18px; }
  .pcard__name {
    font-size: 16px;
    font-weight: var(--fw-bold);
    letter-spacing: .02em;
    line-height: 1.25;
    text-transform: uppercase;
    color: var(--pc-name);
  }
  .pcard__claim { font-size: 13px; font-weight: var(--fw-light); letter-spacing: .05em; text-transform: uppercase; }
  .pcard__format { font-size: 13px; font-style: italic; color: var(--c-muted); }
  .pcard__fluoro { margin-top: 2px; }
  .pcard__gusti { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .pcard__gusto {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 10px 2px 3px;
    border-radius: var(--radius-pill);
    background: var(--pc-light);
    font-size: 12px;
    font-weight: var(--fw-medium);
    color: var(--c-strong);
  }
  .pcard__gusto img { width: 24px; height: 24px; object-fit: contain; }
  .pcard__more {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 12px;
    font-size: 14px;
    font-weight: var(--fw-medium);
    color: var(--c-strong);
  }
</style>
