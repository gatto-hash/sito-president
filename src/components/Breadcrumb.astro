---
/**
 * Breadcrumb globale. L'ultima voce è la pagina corrente (aria-current="page").
 * `colore`: quadratino 10×10 davanti alla voce di una linea.
 */
export interface VoceBreadcrumb {
  label: string;
  href?: string;
  colore?: string;
  /** Colore del testo del link (es. la linea in Bold nel suo colore, AA su bianco). */
  coloreTesto?: string;
}
interface Props {
  voci: VoceBreadcrumb[];
}
const { voci } = Astro.props;
---
<div class="breadcrumb">
  <nav class="container breadcrumb__bar" aria-label="Percorso">
    <ol role="list" class="breadcrumb__list">
      {voci.map((v, i) => {
        const corrente = i === voci.length - 1;
        return (
          <li class="breadcrumb__item">
            {v.colore && <span class="breadcrumb__swatch" aria-hidden="true" style={`background:${v.colore}`}></span>}
            {corrente ? (
              <span class="breadcrumb__current" aria-current="page">{v.label}</span>
            ) : (
              <a
                class:list={['breadcrumb__link', v.coloreTesto && 'breadcrumb__link--strong']}
                href={v.href}
                style={v.coloreTesto ? `color:${v.coloreTesto}` : undefined}
              >{v.label}</a>
            )}
            {!corrente && <span class="breadcrumb__sep" aria-hidden="true">›</span>}
          </li>
        );
      })}
    </ol>
    {Astro.slots.has('fine') && <div class="breadcrumb__end"><slot name="fine" /></div>}
  </nav>
</div>

<style>
  .breadcrumb { border-bottom: 1px solid var(--c-border); }
  .breadcrumb__bar { display: flex; flex-direction: column; align-items: flex-start; padding: 4px 0; }
  .breadcrumb__end { display: flex; align-items: center; }
  @media (min-width: 768px) {
    .breadcrumb__bar { flex-direction: row; align-items: center; justify-content: space-between; gap: 24px; padding: 0; }
  }
  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 8px;
    min-height: 56px;
    margin: 0;
    font-size: 14px;
  }
  .breadcrumb__item { display: flex; align-items: center; gap: 8px; }
  .breadcrumb__swatch { flex: none; width: 10px; height: 10px; }
  .breadcrumb__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--c-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .breadcrumb__link:hover { color: var(--c-strong); }
  .breadcrumb__link--strong { font-weight: var(--fw-bold); letter-spacing: .04em; }
  .breadcrumb__sep { color: var(--c-muted); }
  .breadcrumb__current { color: var(--c-strong); font-weight: var(--fw-bold); }
</style>
