---
/** Fluoro: icona esagonale con "F" in #2B757E + "<ppm> ppm F⁻" in Bold. */
import { etichettaFluoro } from '../../data/prodotti';
interface Props {
  ppm: number;
  size?: 'sm' | 'md';
}
const { ppm, size = 'sm' } = Astro.props;
const icona = size === 'md' ? 28 : 22;
---
<span class:list={['badge-f', `badge-f--${size}`]} role="img" aria-label={etichettaFluoro(ppm)}>
  <svg aria-hidden="true" width={icona} height={icona} viewBox="0 0 24 24">
    <path d="M12 1.8l8.8 5.1v10.2L12 22.2l-8.8-5.1V6.9z" fill="none" stroke="#2B757E" stroke-width="1.8"></path>
    <path d="M9.6 7.6h5.2M9.6 7.6v9M9.6 11.8h4.2" fill="none" stroke="#2B757E" stroke-width="2" stroke-linecap="round"></path>
  </svg>
  {ppm} ppm F⁻
</span>

<style>
  .badge-f {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    color: var(--c-strong);
    font-size: 13px;
    font-weight: var(--fw-bold);
    white-space: nowrap;
  }
  .badge-f svg { flex: none; }
  .badge-f--md { font-size: 16px; gap: 8px; }
</style>
