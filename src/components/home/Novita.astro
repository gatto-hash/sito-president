---
import Icon from '../Icon.astro';
import { rotte } from '../../data/rotte';
import { gradienteLinee } from '../../data/linee';
---
<section class="news" aria-labelledby="news-t">
  <div class="container news__inner">
    <h2 class="news__title" id="news-t">NOVITÀ</h2>

    <ul role="list" class="news__grid">
      <li>
        <article class="news-card card-hover">
          <div class="news-card__visual news-card__visual--stemma">
            <img src="/assets/img/stemma-nero.svg" alt="" width="174" height="158" loading="lazy" class="news-card__stemma" />
          </div>
          <div class="news-card__body">
            <p class="eyebrow">BRAND</p>
            <h3 class="news-card__title">PRESIDENT, un nome.<br />Una missione.</h3>
            <p class="news-card__text">Una “P” coronata da un ramoscello di quercia con le ghiande: dopo 26 anni il marchio rinnova la propria immagine.</p>
            <a class="arrow-link news-card__link" href={rotte.chiSiamo}>Scopri la storia <Icon name="arrow-right" size={16} /></a>
          </div>
        </article>
      </li>

      <li>
        <article class="news-card card-hover">
          <div class="news-card__visual" style={`background:${gradienteLinee()}`}>
            <img src="/assets/img/stemma-bianco.svg" alt="" width="132" height="120" loading="lazy" class="news-card__stemma news-card__stemma--white" />
          </div>
          <div class="news-card__body">
            <p class="eyebrow">CATALOGO 2027</p>
            <h3 class="news-card__title">L’igiene orale si colora di benessere.</h3>
            <p class="news-card__text">Nove linee e un unico linguaggio visivo: un colore per ogni esigenza, dal benessere quotidiano alla cura più specifica.</p>
            <a class="arrow-link news-card__link" href={rotte.gamma}>Scopri la gamma <Icon name="arrow-right" size={16} /></a>
          </div>
        </article>
      </li>

      <li>
        <article class="news-card card-hover">
          <img src="/assets/img/ortho-still.jpg" alt="" width="830" height="1173" loading="lazy" class="news-card__photo" />
          <div class="news-card__body">
            <p class="eyebrow">ORTHO-IMPLANT · GENNAIO 2027</p>
            <h3 class="news-card__title">Kit Ortho-Implant, disponibile da gennaio 2027.</h3>
            <p class="news-card__text">L’essenziale per l’igiene quotidiana di apparecchi e impianti, a casa e in viaggio: spazzolini, dentifricio, filo, scovolini e cera.</p>
            <a class="arrow-link news-card__link" href={rotte.linea('ortho')}>Vai alla linea <Icon name="arrow-right" size={16} /></a>
          </div>
        </article>
      </li>
    </ul>
  </div>
</section>

<style>
  .news { background: var(--c-acqua-light); padding: var(--section-pad) 0; }
  .news__inner { display: flex; flex-direction: column; gap: 32px; }
  .news__title {
    font-size: var(--fs-h2);
    font-weight: var(--fw-light);
    letter-spacing: var(--ls-title);
    line-height: 1.2;
    color: var(--c-strong);
  }

  .news__grid { display: grid; grid-template-columns: 1fr; gap: 24px; margin: 0; }
  .news__grid > li { display: flex; }

  .news-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: #FFFFFF;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 1px 0 var(--c-border);
  }
  .news-card__visual {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 240px;
    flex: none;
  }
  .news-card__visual--stemma { background: linear-gradient(135deg, #FFFFFF 0%, #EAF6F7 45%, #B0DDE2 100%); }
  .news-card__stemma { height: 158px; width: auto; }
  .news-card__stemma--white { height: 120px; filter: drop-shadow(0 3px 6px rgba(0, 0, 0, .35)); }
  .news-card__photo {
    display: block;
    flex: none;
    width: 100%;
    height: 240px;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .news-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    padding: 24px 26px 26px;
  }
  .news-card__title { font-size: 21px; font-weight: var(--fw-bold); line-height: 1.3; color: var(--c-strong); }
  .news-card__text { font-size: 15px; line-height: 1.6; }
  .news-card__link { margin-top: auto; padding-top: 8px; font-size: 15px; align-self: flex-start; }

  @media (min-width: 768px) {
    .news__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .news__inner { gap: 40px; }
    .news__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .news-card { min-height: 520px; }
  }
</style>
