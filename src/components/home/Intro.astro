---
import Icon from '../Icon.astro';
import { rotte } from '../../data/rotte';
import { linee } from '../../data/linee';

const dati = [
  { valore: '2000', testo: 'Nasce PRESIDENT, il brand di igiene orale firmato Betafarma' },
  { valore: String(linee.length), testo: 'Linee di prodotto, un colore per ogni esigenza' },
  { valore: '30+', testo: 'Paesi in cui PRESIDENT è distribuito' },
];
---
<section class="intro" aria-labelledby="intro-t">
  <div class="container intro__grid">
    <div class="intro__text">
      <p class="eyebrow">PRESIDENT DAL 2000</p>
      <h2 class="section-title" id="intro-t">Le radici di un sorriso sano</h2>
      <!-- Da verificare con il cliente: si riferisce a Betafarma (il marchio ha 26 anni). -->
      <p class="subtitle">Cinquant’anni di eccellenza italiana</p>
      <p class="intro__p intro__p--first">
        La storia di <b>PRESIDENT</b> nasce da una passione italiana: il lavoro fatto con cura, competenza e
        <b>rigore scientifico</b>, al servizio dell’igiene orale. Nei Laboratori Betafarma, alle porte di Milano, ogni
        prodotto è <b>sviluppato e fabbricato in Italia</b> con materie prime selezionate e un indice di abrasività (RDA)
        <b>calibrato e dichiarato</b>.
      </p>
      <p class="intro__p">
        Oggi PRESIDENT è una gamma completa di <b>nove linee</b>, ognuna con il proprio colore, che rispondono in modo
        specifico a ogni esigenza: dalla protezione quotidiana alla cura più avanzata.
      </p>
      <div class="intro__links">
        <a class="arrow-link" href={rotte.chiSiamo}>La nostra storia <Icon name="arrow-right" /></a>
        <a class="arrow-link" href={rotte.ricerca.qualita}>Qualità e ricerca <Icon name="arrow-right" /></a>
      </div>
    </div>

    <div class="intro__facts">
      <dl class="facts">
        {dati.map((d) => (
          <div class="facts__row">
            <dt class="facts__value">{d.valore}</dt>
            <dd class="facts__text">{d.testo}</dd>
          </div>
        ))}
      </dl>
      <p class="facts__italy">
        <span class="tricolore" aria-hidden="true"><span></span><span></span><span></span></span>
        SVILUPPATO E PRODOTTO IN ITALIA
      </p>
    </div>
  </div>
</section>

<style>
  .intro { padding: var(--section-pad) 0; }
  .intro__grid { display: grid; grid-template-columns: 1fr; row-gap: 48px; align-items: start; }
  .intro__text { display: flex; flex-direction: column; gap: 16px; }
  .intro__p { font-size: var(--fs-body-lg); line-height: var(--lh-body); }
  .intro__p--first { margin-top: 12px; }
  .intro__links { display: flex; flex-wrap: wrap; gap: 0 32px; margin-top: 16px; }

  .facts { display: flex; flex-direction: column; }
  .facts__row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 26px 0;
    border-top: 1px solid var(--c-acqua);
  }
  .facts__value {
    flex: none;
    width: 108px;
    font-size: 48px;
    font-weight: var(--fw-light);
    line-height: 1;
    color: var(--c-strong);
  }
  .facts__text { font-size: 17px; line-height: 1.45; color: var(--c-text); }

  .facts__italy {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--c-acqua);
    font-size: 13px;
    font-weight: var(--fw-bold);
    letter-spacing: .14em;
    line-height: 1.4;
    color: var(--c-strong);
  }
  .tricolore { display: flex; flex: none; width: 30px; height: 8px; }
  .tricolore span { flex: 1; }
  .tricolore span:nth-child(1) { background: var(--c-it-green); }
  .tricolore span:nth-child(2) { background: #FFFFFF; box-shadow: inset 0 0 0 1px var(--c-border); }
  .tricolore span:nth-child(3) { background: var(--c-it-red); }

  @media (min-width: 1024px) {
    .intro__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .intro__text { grid-column: 1 / span 6; }
    .intro__facts { grid-column: 8 / span 5; }
    .facts__row { gap: 24px; }
    .facts__value { width: 150px; font-size: 64px; }
  }
</style>
