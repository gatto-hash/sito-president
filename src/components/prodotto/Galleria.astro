---
/**
 * Galleria della scheda prodotto: immagine principale quadrata + miniature (aria-pressed).
 * Senza JavaScript resta visibile la prima immagine.
 */
import type { Linea } from '../../data/linee';
import { dim } from '../../data/dimensioni-immagini';

interface Props {
  linea: Linea;
  immagini: { src: string; alt: string; tipo: 'packshot' | 'foto' }[];
}
const { linea, immagini } = Astro.props;
const n = immagini.length;
---
<div
  class="gal"
  data-gallery
  style={`--g-light:${linea.tintaChiara};--g-mid:${linea.tintaMedia};--g-active:${linea.colore}`}
>
  <div class="gal__main">
    {immagini.map((img, i) => (
      <div class:list={['gal__slide', `gal__slide--${img.tipo}`]} data-gallery-slide hidden={i !== 0}>
        <img
          src={img.src}
          alt={img.alt}
          {...dim(img.src)}
          loading={i === 0 ? undefined : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
        />
      </div>
    ))}
  </div>
  {n > 1 && (
    <div class="gal__thumbs" role="group" aria-label="Galleria immagini">
      {immagini.map((img, i) => (
        <button
          type="button"
          class:list={['gal__thumb', `gal__thumb--${img.tipo}`]}
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-label={`Mostra immagine ${i + 1} di ${n}`}
          data-gallery-thumb={i}
        >
          <img src={img.src} alt="" {...dim(img.src)} loading="lazy" />
        </button>
      ))}
    </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const slides = root.querySelectorAll<HTMLElement>('[data-gallery-slide]');
    const thumbs = root.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]');
    thumbs.forEach((t, i) =>
      t.addEventListener('click', () => {
        slides.forEach((s, j) => (s.hidden = j !== i));
        thumbs.forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
      }),
    );
  });
</script>

<style>
  .gal { display: flex; flex-direction: column; gap: 14px; }
  .gal__main {
    width: 100%;
    max-width: 588px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0 0 48px 0;
  }
  .gal__slide { width: 100%; height: 100%; }
  .gal__slide[hidden] { display: none; }
  .gal__slide--packshot {
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(110% 90% at 50% 65%, #FFFFFF 0%, var(--g-light) 50%, var(--g-mid) 100%);
  }
  .gal__slide--packshot img {
    width: auto;
    height: 70%;
    max-width: 80%;
    object-fit: contain;
    filter: drop-shadow(0 18px 24px rgba(0, 40, 90, .22));
  }
  .gal__slide--foto img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .gal__thumbs { display: flex; flex-wrap: wrap; gap: 12px; }
  .gal__thumb {
    flex: none;
    width: 96px;
    height: 96px;
    padding: 0;
    border: 2px solid var(--c-border);
    border-radius: 8px;
    overflow: hidden;
    background: #FFFFFF;
    cursor: pointer;
  }
  .gal__thumb[aria-pressed='true'] { border-color: var(--g-active); }
  .gal__thumb--packshot { display: flex; align-items: center; justify-content: center; background: var(--g-light); }
  .gal__thumb--packshot img { width: auto; height: 80%; object-fit: contain; }
  .gal__thumb--foto img { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
