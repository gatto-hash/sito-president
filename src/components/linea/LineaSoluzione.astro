---
/** La soluzione: testo + pannello attivi nel colore della linea (+ frase di chiusura, se c'è). */
import LineIcon from '../LineIcon.astro';
import { testoLineaSu, type Linea } from '../../data/linee';
import type { ContenutiLinea } from '../../data/linee-contenuti';

interface Props {
  linea: Linea;
  soluzione?: ContenutiLinea['soluzione'];
}
const { linea, soluzione } = Astro.props;
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
const conAttivi = linea.attivi.length > 0;
const testo = soluzione?.testo ?? linea.descrizione;
---
<section
  class="lsol"
  aria-labelledby="soluzione-t"
  style={`--ls-tint:${linea.tintaChiara};--ls-mid:${linea.tintaMedia};--ls-bg:${linea.colore};--ls-fg:${linea.testoSuColore}`}
>
  <div class="container">
    <div class="lsol__grid">
      <div class="lsol__text">
        <p class="eyebrow" style={`color:${testoLineaSu(linea, linea.tintaChiara)}`}>LA SOLUZIONE</p>
        <h2 class="section-title lsol__title" id="soluzione-t">Come agisce la linea {linea.nome}</h2>
        {soluzione?.sottotitolo && <p class="subtitle lsol__subtitle">{soluzione.sottotitolo}</p>}
        <p class="lsol__p" set:html={testo} />
      </div>
      <div class="lsol__panel">
        <h3 class="lsol__panel-title">{conAttivi ? 'ATTIVI SELEZIONATI' : 'I BENEFICI'}</h3>
        <ul role="list" class="lsol__list">
          {conAttivi
            ? linea.attivi.map((a) => (
                <li>
                  <LineIcon name="spunta" size={20} strokeWidth={2.6} class="lsol__check" />
                  <span class="lsol__item">
                    <b>{a.nome}</b>
                    <span>{cap(a.funzione)}</span>
                  </span>
                </li>
              ))
            : linea.benefici.map((b) => (
                <li>
                  <LineIcon name="spunta" size={20} strokeWidth={2.6} class="lsol__check" />
                  <span class="lsol__item"><b>{b}</b></span>
                </li>
              ))}
        </ul>
      </div>
    </div>

    {soluzione?.frase && (
      <div class="lsol__quote">
        <span class="lsol__mark" aria-hidden="true" style={`color:${linea.colore}`}>“</span>
        <p style={`color:${testoLineaSu(linea, linea.tintaChiara, 3)}`}>{soluzione.frase}</p>
      </div>
    )}
  </div>
</section>

<style>
  .lsol { padding: var(--section-pad) 0; background: var(--ls-tint); }
  .lsol__grid { display: grid; grid-template-columns: 1fr; gap: 40px; align-items: start; }
  .lsol__text { display: flex; flex-direction: column; }
  .lsol__title { margin-top: 14px; }
  .lsol__subtitle { margin-top: 16px; }
  .lsol__p { margin-top: 20px; font-size: 17px; line-height: var(--lh-body); }

  .lsol__panel { padding: 32px 24px; background: var(--ls-bg); color: var(--ls-fg); }
  .lsol__panel-title { font-size: 13px; font-weight: var(--fw-bold); letter-spacing: .14em; line-height: 20px; }
  .lsol__list { display: grid; grid-template-columns: 1fr; gap: 24px 32px; margin: 28px 0 0; }
  .lsol__list li { display: flex; gap: 12px; align-items: flex-start; }
  :global(.lsol__check) { flex: none; margin-top: 2px; }
  .lsol__item { display: flex; flex-direction: column; gap: 4px; font-size: 16px; line-height: 1.5; }
  .lsol__item b { font-size: 18px; line-height: 1.3; }

  .lsol__quote {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--ls-mid);
    text-align: center;
  }
  .lsol__mark { display: block; height: 44px; font-size: 96px; font-weight: var(--fw-bold); line-height: 88px; opacity: .35; }
  .lsol__quote p {
    max-width: 1040px;
    font-size: 26px;
    font-weight: var(--fw-bold);
    font-style: italic;
    line-height: 1.25;
  }

  @media (min-width: 1024px) {
    .lsol__grid { grid-template-columns: minmax(0, 440px) minmax(0, 1fr); gap: clamp(40px, 7vw, 100px); }
    .lsol__panel { padding: 48px; }
    .lsol__quote { margin-top: 72px; padding-top: 56px; }
    .lsol__quote p { font-size: 40px; }
  }
  @media (min-width: 1200px) {
    .lsol__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 32px; }
  }
</style>
