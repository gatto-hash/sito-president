---
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import LineIcon from '../LineIcon.astro';
import { testoLineaSu, type Linea } from '../../data/linee';
import type { ContenutiLinea } from '../../data/linee-contenuti';
import { iconeBeneficiDefault } from '../../data/icone';
import { dim } from '../../data/dimensioni-immagini';

interface Props {
  linea: Linea;
  contenuti: ContenutiLinea;
}
const { linea, contenuti } = Astro.props;

const coloreTitolo = testoLineaSu(linea, linea.tintaChiara, 3);
const coloreOcchiello = testoLineaSu(linea, linea.tintaChiara);
const coloreIcone = testoLineaSu(linea, '#FFFFFF', 3);
const benefici =
  contenuti.coverBenefici ??
  linea.benefici.slice(0, 3).map((testo, i) => ({ icona: iconeBeneficiDefault[i], testo }));
const cover = contenuti.cover;
---
<section
  class:list={['lcover', !cover && 'lcover--still']}
  aria-labelledby="linea-t"
  style={`--lc-bg:${linea.tintaChiara}`}
>
  {cover ? (
    <img class="lcover__img" src={cover.immagine} alt={cover.alt} width={cover.larghezza} height={cover.altezza} fetchpriority="high" />
  ) : (
    <img
      class="lcover__img lcover__img--still"
      src={linea.still}
      alt={`Prodotti della linea ${linea.nome}`}
      {...dim(linea.still)}
      fetchpriority="high"
      style={`object-position:50% ${linea.stillY}%`}
    />
  )}
  <div class="container lcover__inner">
    <div class="lcover__text">
      <p class="eyebrow" style={`color:${coloreOcchiello}`}>LINEA PRESIDENT</p>
      <h1 class="lcover__title" id="linea-t" style={`color:${coloreTitolo}`}>{linea.nome}</h1>
      <p class="lcover__promise">{linea.titolo}</p>
      <ul class="lcover__benefits" aria-label="Benefici della linea">
        {benefici.map((b) => (
          <li>
            <span class="lcover__icon"><LineIcon name={b.icona} size={28} color={coloreIcone} /></span>
            <span class="lcover__benefit">{b.testo}</span>
          </li>
        ))}
      </ul>
      <div class="lcover__actions">
        <a class="btn btn--primary" href="#prodotti">Scopri i prodotti <Icon name="arrow-down" /></a>
        <Button href={linea.amazonUrl} variant="secondary" external ariaLabel="Acquista su Amazon: si apre su Amazon in una nuova scheda">Acquista su Amazon</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .lcover { position: relative; background: var(--lc-bg); }
  .lcover__img { display: block; width: 100%; height: 280px; object-fit: cover; object-position: 78% 50%; }
  .lcover__inner { padding: 32px 0 48px; }
  .lcover__text { display: flex; flex-direction: column; }
  .lcover__title {
    margin-top: 12px;
    font-size: 48px;
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-title);
    line-height: 1;
    overflow-wrap: anywhere;
  }
  .lcover__promise {
    margin-top: 16px;
    font-size: 21px;
    font-weight: var(--fw-light);
    letter-spacing: var(--ls-title);
    line-height: 1.25;
    text-transform: uppercase;
    color: var(--c-strong);
  }
  .lcover__benefits { list-style: none; padding: 0; margin: 28px 0 0; display: flex; flex-direction: column; gap: 14px; }
  .lcover__benefits li { display: flex; align-items: center; gap: 14px; }
  .lcover__icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #FFFFFF;
  }
  .lcover__benefit { font-size: 16px; font-weight: var(--fw-bold); line-height: 1.35; color: var(--c-strong); }
  .lcover__actions { display: flex; flex-direction: column; gap: 12px; margin-top: 32px; }
  .lcover__actions > :global(*) { width: 100%; white-space: nowrap; }

  @media (min-width: 600px) {
    .lcover__actions { flex-direction: row; flex-wrap: wrap; gap: 16px; }
    .lcover__actions > :global(*) { width: auto; }
  }

  @media (min-width: 1024px) {
    .lcover { min-height: 640px; overflow: hidden; }
    .lcover__img { position: absolute; inset: 0; height: 100%; object-position: 100% 50%; }
    .lcover__img--still { left: auto; width: 50%; }
    .lcover__inner { position: relative; display: flex; align-items: center; min-height: 640px; padding: 48px 0; }
    .lcover__text { width: min(588px, 52%); }
    .lcover__title { font-size: 80px; }
    .lcover__promise { font-size: 26px; }
    .lcover__benefits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 32px; }
    .lcover__benefits li { flex-direction: column; align-items: flex-start; gap: 12px; }
    .lcover__actions { margin-top: 40px; }
  }
</style>
